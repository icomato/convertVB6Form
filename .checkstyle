<?xml version="1.0" encoding="UTF-8"?>
<fileset-config file-format-version="1.2.0" simple-config="true" sync-formatter="false">
    <local-check-config name="Future Java (project)" location="checkstyle.xml" type="project" description="Future Java規約を基にした共有設定">
        <additional-data name="protect-config-file" value="true"/>
    </local-check-config>
    <fileset name="Java sources" enabled="true" check-config-name="Future Java (project)" local="true">
        <file-match-pattern match-pattern="^src/.*\.java$" include-pattern="true"/>
    </fileset>
</fileset-config>
