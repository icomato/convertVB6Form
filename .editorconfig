root = true

[*.java]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab
indent_size = tab
tab_width = 4
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.sh]
charset = utf-8
end_of_line = lf
insert_final_newline = true
